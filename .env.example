# Web app settings (backend/ and frontend/ both read this file).
# Copy it to `.env` in this folder and fill in your own values -- never commit `.env`.

# Binance API Credentials
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# GitHub API Configuration (for pushing Excel files)
# Generate token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=Risk-Management
GITHUB_BRANCH=main

# Frontend (only VITE_* variables reach the browser; start-*.bat sets VITE_API_URL itself)
# VITE_API_URL=http://localhost:8000
